      "phases": [
        {
          "id": "phase_1",
          "title": "Master & lookup data",
          "rationale": "Reference masters (categories, tax codes, discounts, customers, partners) that every transaction looks up.",
          "objects": [
            "surz_category",
            "surz_hsn_gst",
            "surz_discount",
            "surz_customer",
            "surz_partner",
            "surz_product"
          ]
        },
        {
          "id": "phase_2",
          "title": "Core transactions",
          "rationale": "Transactions that reference products, customers and partners: cart, orders, stock moves, enquiries, partner orders.",
          "objects": [
            "surz_cart",
            "surz_order",
            "surz_stock_move",
            "surz_enquiry",
            "surz_partner_order"
          ]
        },
        {
          "id": "phase_3",
          "title": "Schemas & visuals",
          "rationale": "Datasets over order and sales data, then the charts that read from them.",
          "objects": [
            "SURZ_SALES_LINE",
            "SURZ_ORDER_HEADER",
            "surz_revenue_trend",
            "surz_top_instruments",
            "surz_category_mix",
