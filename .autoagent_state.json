            "surz_net_billed_trend"
          ]
        },
        {
          "id": "phase_4",
          "title": "Dashboards",
          "rationale": "Sales and partner dashboards that embed the visuals built in the previous phase.",
          "objects": [
            "surz_sales_dashboard",
            "surz_partner_dashboard"
          ]
        },
        {
          "id": "phase_5",
          "title": "Site chrome & core store pages",
