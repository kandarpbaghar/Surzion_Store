{
  "table_name": "SURZ_CUSTOMER_PAYMENT_METHOD",
  "description": "Customer saved payment preferences - no full card data (surz_customer_payment_method)",
  "managed": true,
  "columns": [
    {"column_name": "METHOD_ID", "data_type": "VARCHAR", "size": "20", "sequence": 1, "key": true, "mandatory": true, "description": "Method id"},
    {"column_name": "REGISTRY_ID", "data_type": "VARCHAR", "size": "120", "sequence": 2, "key": false, "mandatory": false, "description": "Shop account"},
    {"column_name": "CUSTOMER_ID", "data_type": "VARCHAR", "size": "20", "sequence": 3, "key": false, "mandatory": false, "description": "Customer",
     "lookup": {"table": "SURZ_CUSTOMER", "display_column": "CUSTOMER_NAME", "value_column": "CUSTOMER_ID"}},
    {"column_name": "METHOD_TYPE", "data_type": "VARCHAR", "size": "12", "sequence": 4, "key": false, "mandatory": true, "description": "Method type",
     "allowed_values": ["COD", "UPI", "CARD", "NETBANKING"]},
    {"column_name": "LABEL", "data_type": "VARCHAR", "size": "60", "sequence": 5, "key": false, "mandatory": false, "description": "Label"},
    {"column_name": "UPI_ID", "data_type": "VARCHAR", "size": "80", "sequence": 6, "key": false, "mandatory": false, "description": "UPI id"},
    {"column_name": "CARD_BRAND", "data_type": "VARCHAR", "size": "20", "sequence": 7, "key": false, "mandatory": false, "description": "Card brand"},
    {"column_name": "CARD_LAST4", "data_type": "VARCHAR", "size": "4", "sequence": 8, "key": false, "mandatory": false, "description": "Card last 4 digits"},
    {"column_name": "GATEWAY_TOKEN", "data_type": "VARCHAR", "size": "200", "sequence": 9, "key": false, "mandatory": false, "description": "Gateway token (server-side only)"},
    {"column_name": "IS_DEFAULT", "data_type": "VARCHAR", "size": "1", "sequence": 10, "key": false, "mandatory": false, "description": "Default method",
     "allowed_values": ["Y", "N"]},
    {"column_name": "ADD_DATE", "data_type": "DATETIME", "size": "", "sequence": 11, "key": false, "mandatory": false, "description": "Added on"},
    {"column_name": "ADD_USER", "data_type": "VARCHAR", "size": "10", "sequence": 12, "key": false, "mandatory": false, "description": "Added by"},
    {"column_name": "CHG_DATE", "data_type": "DATETIME", "size": "", "sequence": 13, "key": false, "mandatory": false, "description": "Changed on"},
    {"column_name": "CHG_USER", "data_type": "VARCHAR", "size": "10", "sequence": 14, "key": false, "mandatory": false, "description": "Changed by"}
  ]
}
