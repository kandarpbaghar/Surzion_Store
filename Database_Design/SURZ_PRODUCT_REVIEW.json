{
  "table_name": "SURZ_PRODUCT_REVIEW",
  "description": "Product review with moderation (surz_product_review)",
  "managed": true,
  "columns": [
    {"column_name": "REVIEW_ID", "data_type": "VARCHAR", "size": "20", "sequence": 1, "key": true, "mandatory": true, "description": "Review id"},
    {"column_name": "PRODUCT_CODE", "data_type": "VARCHAR", "size": "20", "sequence": 2, "key": false, "mandatory": true, "description": "Instrument",
     "lookup": {"table": "SURZ_PRODUCT", "display_column": "PRODUCT_NAME", "value_column": "PRODUCT_CODE"}},
    {"column_name": "RATING", "data_type": "INTEGER", "size": "", "sequence": 3, "key": false, "mandatory": true, "description": "Rating (1-5)"},
    {"column_name": "TITLE", "data_type": "VARCHAR", "size": "160", "sequence": 4, "key": false, "mandatory": false, "description": "Title"},
    {"column_name": "REVIEW_TEXT", "data_type": "TEXT", "size": "", "sequence": 5, "key": false, "mandatory": true, "description": "Review"},
    {"column_name": "REVIEWER_NAME", "data_type": "VARCHAR", "size": "120", "sequence": 6, "key": false, "mandatory": false, "description": "Reviewer name"},
    {"column_name": "REVIEWER_REGISTRY_ID", "data_type": "VARCHAR", "size": "120", "sequence": 7, "key": false, "mandatory": false, "description": "Reviewer shop account"},
    {"column_name": "STATUS", "data_type": "VARCHAR", "size": "16", "sequence": 8, "key": false, "mandatory": false, "description": "Status",
     "allowed_values": ["PENDING", "APPROVED", "REJECTED"]},
    {"column_name": "MODERATOR_NOTE", "data_type": "VARCHAR", "size": "400", "sequence": 9, "key": false, "mandatory": false, "description": "Moderator note"},
    {"column_name": "VERIFIED", "data_type": "VARCHAR", "size": "1", "sequence": 14, "key": false, "mandatory": false, "description": "Verified purchase", "default_value": "N",
     "allowed_values": ["Y", "N"]},
    {"column_name": "ADD_DATE", "data_type": "DATETIME", "size": "", "sequence": 10, "key": false, "mandatory": false, "description": "Added on"},
    {"column_name": "ADD_USER", "data_type": "VARCHAR", "size": "10", "sequence": 11, "key": false, "mandatory": false, "description": "Added by"},
    {"column_name": "CHG_DATE", "data_type": "DATETIME", "size": "", "sequence": 12, "key": false, "mandatory": false, "description": "Changed on"},
    {"column_name": "CHG_USER", "data_type": "VARCHAR", "size": "10", "sequence": 13, "key": false, "mandatory": false, "description": "Changed by"}
  ]
}
