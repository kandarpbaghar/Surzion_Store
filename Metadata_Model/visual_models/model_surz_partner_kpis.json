  "SOURCE_SQL": "WITH p AS (SELECT o.ORDER_NO, COALESCE(o.SUBTOTAL, 0) AS GROSS, COALESCE(o.DISCOUNT_AMT, 0) AS DISC FROM SURZ_ORDER o WHERE o.PARTNER_ID IS NOT NULL AND o.PARTNER_ID <> '' AND COALESCE(o.ORDER_STATUS, 'NEW') <> 'CANCELLED' AND o.ORDER_DATE >= ?.from_date AND o.ORDER_DATE <= ?.to_date AND o.PARTNER_NAME LIKE ?.partner_name)\nSELECT KPI_LABEL, KPI_VALUE FROM (\n  SELECT 1 AS KPI_SEQ, 'Partner orders' AS KPI_LABEL, CAST(COUNT(*) AS NUMERIC) AS KPI_VALUE FROM p\n  UNION ALL SELECT 2, 'Gross sales (INR)', CAST(COALESCE(SUM(GROSS), 0) AS NUMERIC) FROM p\n  UNION ALL SELECT 3, 'Discount given (INR)', CAST(COALESCE(SUM(DISC), 0) AS NUMERIC) FROM p\n  UNION ALL SELECT 4, 'Net sales (INR)', CAST(COALESCE(SUM(GROSS - DISC), 0) AS NUMERIC) FROM p\n  UNION ALL SELECT 5, 'Active partners', CAST(COUNT(*) AS NUMERIC) FROM SURZ_PARTNER WHERE STATUS = 'APPROVED'\n) k ORDER BY KPI_SEQ"
}
