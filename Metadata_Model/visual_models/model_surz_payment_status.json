  },
  "SOURCE_SQL": "SELECT COALESCE(o.PAY_STATUS, 'PENDING')      AS PAY_STATUS,\n       COALESCE(SUM(o.TOTAL_AMOUNT), 0)           AS ORDER_VALUE,\n       COUNT(*)                                   AS ORDER_COUNT,\n       'Order value (INR)'                        AS LBL_VALUE,\n       'orders'                                   AS LBL_ORDERS\n  FROM SURZ_ORDER o\n WHERE o.ORDER_DATE BETWEEN ?.from_date AND ?.to_date\n GROUP BY COALESCE(o.PAY_STATUS, 'PENDING')\n ORDER BY CASE COALESCE(o.PAY_STATUS, 'PENDING')\n            WHEN 'PENDING'  THEN 1\n            WHEN 'COD'      THEN 2\n            WHEN 'FAILED'   THEN 3\n            WHEN 'PAID'     THEN 4\n            WHEN 'REFUNDED' THEN 5\n            ELSE 6\n          END"
}
