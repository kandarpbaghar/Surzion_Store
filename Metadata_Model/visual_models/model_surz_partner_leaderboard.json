  "SOURCE_SQL": "SELECT o.PARTNER_NAME AS PARTNER_NAME,\n       p.ORG_NAME AS ORG_NAME,\n       COUNT(o.ORDER_NO) AS ORDER_COUNT,\n       COALESCE(SUM(o.SUBTOTAL), 0) AS GROSS_SALES,\n       COALESCE(SUM(o.DISCOUNT_AMT), 0) AS DISCOUNT_GIVEN,\n       COALESCE(SUM(COALESCE(o.SUBTOTAL, 0) - COALESCE(o.DISCOUNT_AMT, 0)), 0) AS NET_SALES,\n       COALESCE(SUM(COALESCE(o.SUBTOTAL, 0) - COALESCE(o.DISCOUNT_AMT, 0)) / NULLIF(COUNT(o.ORDER_NO), 0), 0) AS AVG_ORDER,\n       MAX(o.ORDER_DATE) AS LAST_ORDER_DATE\n  FROM SURZ_ORDER o\n  LEFT JOIN SURZ_PARTNER p ON p.PARTNER_ID = o.PARTNER_ID\n WHERE o.PARTNER_ID IS NOT NULL AND o.PARTNER_ID <> ''\n   AND COALESCE(o.ORDER_STATUS, 'NEW') <> 'CANCELLED'\n   AND o.ORDER_DATE >= ?.from_date AND o.ORDER_DATE <= ?.to_date\n   AND o.PARTNER_NAME LIKE ?.partner_name\n GROUP BY o.PARTNER_ID, o.PARTNER_NAME, p.ORG_NAME\n ORDER BY NET_SALES DESC\n LIMIT 10"
}
