  "SOURCE_SQL": "SELECT STAGE, APPLICATIONS FROM (\n  SELECT 1 AS STAGE_SEQ, 'Applied' AS STAGE, COUNT(*) AS APPLICATIONS FROM SURZ_PARTNER\n  UNION ALL SELECT 2, 'Reviewed (approved or rejected)', COUNT(*) FROM SURZ_PARTNER WHERE STATUS IN ('APPROVED', 'REJECTED')\n  UNION ALL SELECT 3, 'Approved', COUNT(*) FROM SURZ_PARTNER WHERE STATUS = 'APPROVED'\n) f ORDER BY STAGE_SEQ"
}
