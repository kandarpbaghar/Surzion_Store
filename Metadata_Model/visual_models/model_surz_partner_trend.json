  "SOURCE_SQL": "SELECT TO_CHAR(DATE_TRUNC('month', o.ORDER_DATE), 'YYYY-MM') AS ORDER_MONTH,\n       COALESCE(SUM(o.SUBTOTAL), 0) AS GROSS_SALES,\n       COALESCE(SUM(COALESCE(o.SUBTOTAL, 0) - COALESCE(o.DISCOUNT_AMT, 0)), 0) AS NET_SALES\n  FROM SURZ_ORDER o\n WHERE o.PARTNER_ID IS NOT NULL AND o.PARTNER_ID <> ''\n   AND COALESCE(o.ORDER_STATUS, 'NEW') <> 'CANCELLED'\n   AND o.ORDER_DATE >= ?.from_date AND o.ORDER_DATE <= ?.to_date\n   AND o.PARTNER_NAME LIKE ?.partner_name\n GROUP BY TO_CHAR(DATE_TRUNC('month', o.ORDER_DATE), 'YYYY-MM')\n ORDER BY TO_CHAR(DATE_TRUNC('month', o.ORDER_DATE), 'YYYY-MM')"
}
