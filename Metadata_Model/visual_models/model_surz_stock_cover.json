  "SOURCE_SQL": "SELECT p.PRODUCT_CODE                                             AS PRODUCT_CODE,\n       p.PRODUCT_NAME                                             AS PRODUCT_NAME,\n       c.CATEGORY_NAME                                            AS CATEGORY_NAME,\n       COALESCE(p.STOCK_QTY, 0)                                   AS STOCK_QTY,\n       COALESCE(p.REORDER_LEVEL, 0)                               AS REORDER_LEVEL,\n       COALESCE(p.REORDER_LEVEL, 0) - COALESCE(p.STOCK_QTY, 0)    AS SHORTFALL_QTY,\n       COALESCE(p.UNIT_PRICE, 0)\n         * GREATEST(COALESCE(p.REORDER_LEVEL, 0) - COALESCE(p.STOCK_QTY, 0), 0) AS REFILL_VALUE\n  FROM SURZ_PRODUCT p\n  LEFT JOIN SURZ_CATEGORY c ON c.CATEGORY_CODE = p.CATEGORY_CODE\n WHERE p.IS_ACTIVE = 'Y'\n   AND COALESCE(p.STOCK_QTY, 0) <= COALESCE(p.REORDER_LEVEL, 0)\n   AND COALESCE(c.CATEGORY_NAME, '') LIKE ?.category_name\n ORDER BY COALESCE(p.REORDER_LEVEL, 0) - COALESCE(p.STOCK_QTY, 0) DESC, p.PRODUCT_NAME\n LIMIT 10"
}
