            {
              "column": {
                "name": "product_code",
                "db_name": "PRODUCT_CODE",
                "col_type": "VARCHAR20",
                "heading": "Instrument",
                "group_name": "Basic",
                "mandatory": 1,
                "key": false,
                "protect": 0,
                "hidden": 0,
                "lookup": "SURZ_PRODUCT(PRODUCT_NAME, PRODUCT_CODE)",
                "must_exist_in": "SURZ_PRODUCT",
                "item_change": {
                  "mode": "rule",
                  "source_table": "SURZ_PRODUCT",
                  "match_table_col": "PRODUCT_CODE",
                  "fill": [
                    {
                      "form_col": "product_name",
                      "table_col": "PRODUCT_NAME"
                    },
                    {
                      "form_col": "unit_price",
                      "table_col": "UNIT_PRICE"
                    },
                    {
                      "form_col": "gst_rate",
                      "table_col": "GST_RATE"
                    },
                    {
                      "form_col": "line_total",
                      "expr": "round({form.QTY} * {form.UNIT_PRICE}, 2)"
                    }
                  ]
                }
              }
            },
            {
              "column": {
                "name": "product_name",
                "db_name": "PRODUCT_NAME",
                "col_type": "VARCHAR160",
                "heading": "Name",
                "group_name": "Basic",
                "mandatory": 0,
                "key": false,
                "protect": 1,
                "hidden": 0
              }
            },
            {
              "column": {
                "name": "qty",
                "db_name": "QTY",
                "col_type": "NUMBER12_2",
                "heading": "Qty",
                "group_name": "Basic",
                "mandatory": 1,
                "key": false,
                "protect": 0,
                "hidden": 0,
                "default_value": "1",
                "validations": [
                  {
                    "name": "qty_min",
                    "type": "builtin",
                    "builtin": {
                      "kind": "value_in_range",
                      "min": 1
                    },
                    "message": "Quantity must be at least 1."
                  }
                ],
                "item_change": {
                  "mode": "business_logic",
                  "business_logic": {
                    "method": "surz_cart_line_total",
                    "description": "Recompute the line total",
                    "spec": "On a change of QTY or UNIT_PRICE set LINE_TOTAL = round(QTY * UNIT_PRICE, 2), computed in Decimal so the printed rupee figure is exact. Refuse QTY < 1 with a field error on QTY. The refusal carries NO column updates: a structured `errors` return is answered by _apply_entries, which returns `updates: {}` and never reaches the branch that honours updates beside an error, so a returned LINE_TOTAL would be silently dropped rather than clearing anything. Bound to QTY, UNIT_PRICE and LINE_TOTAL: an item_change fires only for the column that was edited, and LINE_TOTAL is protected. The blocking refusal is the qty_min VALIDATION beside it \u2014 an item_change error is a best-effort cascade the client does not stop on."
                  }
                }
              }
            },
            {
              "column": {
                "name": "unit_price",
                "db_name": "UNIT_PRICE",
                "col_type": "NUMBER12_2",
