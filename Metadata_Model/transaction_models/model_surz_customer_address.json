            {"column": {"name": "label", "db_name": "LABEL", "col_type": "VARCHAR20", "heading": "Label", "group_name": "Basic", "mandatory": 0, "key": false, "protect": 0, "hidden": 0,
              "edit_mask": {"mask": "dropdown", "values": ["Home", "Clinic", "Hospital", "Office", "Other"]}}},
            {"column": {"name": "contact_name", "db_name": "CONTACT_NAME", "col_type": "VARCHAR120", "heading": "Contact name", "group_name": "Basic", "mandatory": 0, "key": false, "protect": 0, "hidden": 0}},
            {"column": {"name": "phone", "db_name": "PHONE", "col_type": "VARCHAR30", "heading": "Phone", "group_name": "Basic", "mandatory": 0, "key": false, "protect": 0, "hidden": 0}},
            {"column": {"name": "address_line1", "db_name": "ADDRESS_LINE1", "col_type": "VARCHAR400", "heading": "Address", "group_name": "Basic", "mandatory": 1, "key": false, "protect": 0, "hidden": 0, "edit_mask": {"mask": "textarea"}}},
            {"column": {"name": "address_line2", "db_name": "ADDRESS_LINE2", "col_type": "VARCHAR200", "heading": "Address line 2", "group_name": "Basic", "mandatory": 0, "key": false, "protect": 0, "hidden": 0}},
