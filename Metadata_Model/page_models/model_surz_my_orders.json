          "link": "#0B1A3D",
          "linkHover": "#14307A",
          "surface": "#EDF1FA",
          "primary": "#2F6BE6",
          "onPrimary": "#ffffff",
          "border": "rgba(15,23,42,0.12)",
          "fromTheme": true
        }
      ]
    }
  }
}