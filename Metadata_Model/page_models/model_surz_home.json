                "path": "PRODUCT_NAME"
              },
              "card.imageUrl": {
                "source": "item_field",
                "path": "IMAGE_URL"
              },
              "card.badge": {
                "source": "item_field",
                "path": "RIBBON"
              },
              "card.price": {
                "source": "item_field",
                "path": "UNIT_PRICE"
              },
              "card.compareAtPrice": {
                "source": "item_field",
                "path": "MRP"
              },
