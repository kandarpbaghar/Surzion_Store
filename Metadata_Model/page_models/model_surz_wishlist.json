{
  "page": {
    "obj_name": "surz_wishlist",
    "title": "Wishlist",
    "kind": "external",
    "pageMode": "web",
    "pageSchemaVersion": 2,
    "theme": {
      "ref": "surzion",
      "preset": "corporate",
      "palette": {
        "primary": "#0E2358",
        "primaryHover": "#14307A",
        "onPrimary": "#FFFFFF",
        "accent": "#2F6BE6",
