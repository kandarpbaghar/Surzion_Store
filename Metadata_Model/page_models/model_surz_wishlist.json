        "customHeadingFamily": "Poppins",
        "customFontWeights": [
          400,
          500,
          600,
          700
        ],
        "baseSize": 16,
        "scaleRatio": 1.25,
        "lineHeight": 1.6,
        "headingWeight": 600,
        "headingLineHeight": 1.2,
        "eyebrowTransform": "uppercase"
      },
      "layout": {
        "contentWidth": "wide",
        "maxWidth": 1220,
        "paddingX": 24,
        "paddingY": 0,
        "blockGap": 16,
        "borderRadius": 24,
        "buttonRadius": 999,
        "background": {
          "kind": "color",
          "color": "#F5F8FE"
        }
      }
    },
    "inputs": [],
    "actions": [],
    "sections": [
      {
        "id": "sec_head",
        "tag": "main",
        "width": "full",
        "style": {
          "background": {
            "kind": "color",
            "color": "var(--pg-surface)"
          },
          "padding": {
            "top": 48,
            "bottom": 40
          }
        },
        "blocks": [
          {
            "id": "bc",
            "type": "breadcrumb",
            "align": "left",
            "separator": "/",
            "structuredData": true,
            "items": [
              {
                "id": "bc0",
                "label": "Home",
                "href": "/"
              },
              {
                "id": "bc1",
                "label": "Wishlist",
                "href": "/wishlist"
              }
            ]
          },
          {
            "id": "h",
            "type": "heading",
            "level": 1,
            "text": "Your wishlist"
          },
          {
            "id": "p",
            "type": "paragraph",
            "text": "Instruments you saved for later. No sign-in needed; the list is kept in this browser."
          }
        ]
      },
      {
        "id": "sec_list",
        "tag": "main",
        "width": "full",
        "style": {
          "background": {
            "kind": "color",
            "color": "var(--pg-background)"
          },
          "padding": {
            "top": 48,
            "bottom": 80
          }
        },
        "blocks": [
          {
            "id": "wl",
            "type": "wishlist_lines",
            "emptyText": "Your wishlist is empty. Tap the heart on any instrument to save it here.",
            "continueLabel": "Browse the instruments",
            "continueHref": "/instruments",
            "moveLabel": "Move to cart",
            "removeLabel": "Remove",
            "showMove": true,
            "keepAfterMove": false
          },
          {
            "id": "wl_btns",
            "type": "button_group",
            "align": "left",
            "buttons": [
              {
                "id": "wl_cart",
                "label": "Go to cart",
                "variant": "primary",
                "size": "md",
                "icon": "shopping-cart",
                "on_click": {
                  "kind": "external_url",
                  "url": "/cart",
                  "newTab": false
                }
              },
              {
                "id": "wl_shop",
                "label": "Continue shopping",
                "variant": "outline",
                "size": "md",
                "on_click": {
                  "kind": "external_url",
                  "url": "/instruments",
                  "newTab": false
                }
              }
            ]
          }
        ]
      }
    ],
    "blocks": [],
    "seo": {
      "title": "Wishlist | Surzion",
      "description": "Instruments you saved for later."
    },
