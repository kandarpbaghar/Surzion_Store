{
  "page": {
    "obj_name": "surz_my_account",
    "title": "My account",
    "kind": "external",
    "pageMode": "web",
    "pageSchemaVersion": 2,
    "theme": {
      "ref": "surzion",
      "preset": "corporate",
      "palette": {
        "primary": "#0E2358",
        "primaryHover": "#14307A",
        "onPrimary": "#FFFFFF",
        "accent": "#2F6BE6",
        "accentHover": "#14307A",
        "onAccent": "#FFFFFF",
        "heading": "#0B1A3D",
        "text": "#0B1A3D",
        "muted": "#5B6B8C",
        "subtle": "#8494B4",
        "link": "#2F6BE6",
        "linkHover": "#14307A",
        "inverted": "#FFFFFF",
        "background": "#F5F8FE",
        "surface": "#FFFFFF",
        "surfaceAlt": "#FFFFFF",
        "surfaceMuted": "#EDF1FA",
        "border": "#E4EAF6",
        "borderStrong": "#DCE4F3",
        "info": "#2F6BE6",
        "infoBg": "#E8EFFD",
        "success": "#1F9D63",
        "successBg": "#E5F5EE",
        "error": "#C2402F"
      },
      "typography": {
        "fontFamily": "poppins",
        "headingFamily": "poppins",
        "customFontFamily": "Poppins",
        "customHeadingFamily": "Poppins",
        "customFontWeights": [
          400,
          500,
          600,
          700
        ],
        "baseSize": 16,
        "scaleRatio": 1.25,
        "lineHeight": 1.6,
        "headingWeight": 600,
        "headingLineHeight": 1.2,
        "eyebrowTransform": "uppercase"
      },
      "layout": {
        "contentWidth": "wide",
        "maxWidth": 1220,
        "paddingX": 24,
        "paddingY": 0,
        "blockGap": 16,
        "borderRadius": 24,
        "buttonRadius": 999,
        "background": {
          "kind": "color",
          "color": "#F5F8FE"
        }
      }
    },
    "chrome": {
      "smoothScroll": true
    },
    "inputs": [],
    "actions": [],
    "sections": [
      {
        "id": "sec_head",
        "tag": "main",
        "width": "full",
        "style": {
          "background": {
            "kind": "color",
            "color": "var(--pg-surface)"
          },
          "padding": {
            "top": 48,
            "bottom": 40
          }
        },
        "blocks": [
          {
            "id": "bc",
            "type": "breadcrumb",
            "align": "left",
            "separator": "/",
            "structuredData": true,
            "items": [
              {
                "id": "bc0",
                "label": "Home",
                "href": "/"
              },
              {
                "id": "bc1",
                "label": "My account",
                "href": "/my-account"
              }
            ]
          },
          {
            "id": "h",
            "type": "heading",
            "level": 1,
            "text": "My account"
          },
          {
            "id": "p",
            "type": "paragraph",
            "text": "Manage your delivery addresses and saved payment preferences. Only you can see them. To change your password use the account menu at the top right."
          },
          {
            "id": "head_btns",
            "type": "button_group",
            "align": "left",
            "buttons": [
              {
                "id": "hb_addr",
                "label": "Address book",
                "variant": "outline",
                "size": "md",
                "on_click": {
                  "kind": "scroll_to",
                  "target": "addresses"
                }
              },
              {
                "id": "hb_pay",
                "label": "Saved payment methods",
                "variant": "outline",
                "size": "md",
                "on_click": {
                  "kind": "scroll_to",
                  "target": "payments"
                }
              },
              {
                "id": "hb_ord",
                "label": "My orders",
                "variant": "primary",
                "size": "md",
                "on_click": {
                  "kind": "external_url",
                  "url": "/my-orders",
                  "newTab": false
                }
              }
            ]
          }
        ]
      },
      {
        "id": "sec_addr",
        "anchorId": "addresses",
        "tag": "main",
        "width": "full",
        "style": {
          "background": {
            "kind": "color",
            "color": "var(--pg-background)"
          },
          "padding": {
            "top": 56,
            "bottom": 48
          }
        },
        "blocks": [
          {
            "id": "ah",
            "type": "heading",
            "level": 2,
            "text": "Address book"
          },
          {
            "id": "ap",
            "type": "paragraph",
            "text": "Save several delivery addresses and mark one as your default. They appear as a picker at checkout."
          },
          {
            "id": "em_addr",
            "type": "saved_records",
            "object": "surz_customer_address",
            "kind": "address",
            "defaultColumn": "IS_DEFAULT",
            "defaultValue": "Y",
            "notDefaultValue": "N",
            "formTitle": "Address",
            "maxRecords": 20,
            "fields": [
              {
                "key": "label",
                "label": "Save as (e.g. Home, Clinic, Hospital)",
                "column": "LABEL",
                "role": "title",
                "maxLength": 20,
                "placeholder": "Home"
              },
              {
                "key": "name",
                "label": "Full name",
                "column": "CONTACT_NAME",
                "role": "line",
                "required": true,
                "autocomplete": "name",
                "maxLength": 120,
                "half": true
              },
              {
                "key": "phone",
                "label": "Mobile number",
                "column": "PHONE",
                "kind": "tel",
                "role": "meta",
                "required": true,
                "autocomplete": "tel",
                "maxLength": 30,
                "half": true
              },
              {
                "key": "line1",
                "label": "Flat / house no., building, street",
                "column": "ADDRESS_LINE1",
                "role": "line",
                "required": true,
                "autocomplete": "address-line1",
                "maxLength": 400
              },
              {
                "key": "line2",
                "label": "Area, landmark (optional)",
                "column": "ADDRESS_LINE2",
                "role": "line",
                "autocomplete": "address-line2",
                "maxLength": 200
              },
              {
                "key": "city",
                "label": "City",
                "column": "CITY",
                "role": "line",
                "required": true,
                "autocomplete": "address-level2",
                "maxLength": 80,
                "half": true
              },
              {
                "key": "state",
                "label": "State",
                "column": "STATE_NAME",
                "role": "line",
                "joinPrevious": true,
                "required": true,
                "autocomplete": "address-level1",
                "maxLength": 80,
                "half": true
              },
              {
                "key": "pin",
                "label": "PIN code",
                "column": "PINCODE",
                "kind": "postcode",
                "role": "line",
                "joinPrevious": true,
                "required": true,
                "autocomplete": "postal-code",
                "pattern": "^[1-9][0-9]{5}$",
                "maxLength": 6,
                "half": true,
                "placeholder": "6 digits"
              }
            ],
            "addLabel": "Add a new address",
            "emptyText": "No saved addresses yet — add one now and checkout will offer it next time."
          }
        ]
      },
      {
        "id": "sec_pay",
        "anchorId": "payments",
        "tag": "main",
        "width": "full",
        "style": {
          "background": {
            "kind": "color",
            "color": "var(--pg-surface)"
          },
          "padding": {
            "top": 56,
            "bottom": 80
          }
        },
        "blocks": [
          {
            "id": "ph",
            "type": "heading",
            "level": 2,
            "text": "Saved payment methods"
          },
          {
            "id": "pp",
            "type": "paragraph",
            "text": "Your preferred ways to pay (Cash on Delivery, UPI, card, net banking). We never store card numbers, CVV or expiry."
          },
          {
            "id": "em_pay",
            "type": "saved_records",
            "object": "surz_customer_payment_method",
            "kind": "payment_method",
            "defaultColumn": "IS_DEFAULT",
            "defaultValue": "Y",
            "notDefaultValue": "N",
            "formTitle": "Payment method",
            "maxRecords": 10,
            "fields": [
              {
                "key": "type",
                "label": "How would you like to pay?",
                "column": "METHOD_TYPE",
                "kind": "select",
                "optionsFrom": "payment_methods",
                "required": true,
                "role": "title"
              },
              {
                "key": "label",
                "label": "Nickname (optional)",
                "column": "LABEL",
                "role": "meta",
                "maxLength": 60,
                "placeholder": "e.g. Clinic account"
              },
              {
                "key": "upi",
                "label": "UPI ID",
                "column": "UPI_ID",
                "role": "line",
                "required": true,
                "maxLength": 80,
                "placeholder": "name@bank",
                "showWhen": {
                  "key": "type",
                  "in": [
                    "UPI"
                  ]
                },
                "pattern": "^[A-Za-z0-9._-]{2,}@[A-Za-z][A-Za-z0-9.-]{1,}$"
              },
              {
                "key": "brand",
                "label": "Card network",
                "column": "CARD_BRAND",
                "kind": "select",
                "options": [
                  {
                    "value": "VISA",
                    "label": "Visa"
                  },
                  {
                    "value": "MASTERCARD",
                    "label": "Mastercard"
                  },
                  {
                    "value": "RUPAY",
                    "label": "RuPay"
                  },
                  {
                    "value": "AMEX",
                    "label": "American Express"
                  }
                ],
                "role": "line",
                "showWhen": {
                  "key": "type",
                  "in": [
                    "CARD"
                  ]
                },
                "half": true
              },
              {
                "key": "last4",
                "label": "Last 4 digits (for your reference)",
                "column": "CARD_LAST4",
                "role": "line",
                "joinPrevious": true,
                "maxLength": 4,
                "pattern": "^[0-9]{4}$",
                "placeholder": "1234",
                "showWhen": {
                  "key": "type",
                  "in": [
                    "CARD"
                  ]
                },
                "half": true
              }
            ],
            "addLabel": "Add a payment method",
            "emptyText": "No saved payment methods yet. Your full card details are never stored — you enter them securely with the payment gateway at checkout."
          }
        ]
      }
    ],
    "blocks": [],
    "seo": {
      "title": "My account | Surzion",
      "description": "Your Surzion address book and saved payment methods."
    },
    "navigation": {
      "showHeader": true,
      "showFooter": true
    },
    "designTokens": {
      "colorSchemes": [
        {
          "id": "cs_footer",
          "name": "Dark footer band",
          "background": "#102027",
          "text": "#FFFFFF",
          "textSecondary": "#C9D6F2",
          "accent": "#9DB8F5",
          "link": "#C9D6F2",
          "linkHover": "#FFFFFF",
          "surface": "#102027",
          "primary": "#9DB8F5",
          "onPrimary": "#111827",
          "border": "rgba(255,255,255,0.14)",
          "fromTheme": true
        },
        {
          "id": "cs_navy",
          "name": "Navy band",
          "background": "#0E2358",
          "text": "#FFFFFF",
          "textSecondary": "#C9D6F2",
          "accent": "#9DB8F5",
          "link": "#C9D6F2",
          "linkHover": "#FFFFFF",
          "surface": "#0E2358",
          "primary": "#FFFFFF",
          "onPrimary": "#0E2358",
          "border": "rgba(255,255,255,0.14)",
          "fromTheme": true
        },
        {
          "id": "cs_tint",
          "name": "Tinted band",
          "background": "#EDF1FA",
          "text": "#0B1A3D",
          "textSecondary": "#5B6B8C",
          "accent": "#2F6BE6",
          "link": "#0B1A3D",
          "linkHover": "#14307A",
          "surface": "#EDF1FA",
          "primary": "#2F6BE6",
          "onPrimary": "#ffffff",
          "border": "rgba(15,23,42,0.12)",
          "fromTheme": true
        }
      ]
    }
  }
}