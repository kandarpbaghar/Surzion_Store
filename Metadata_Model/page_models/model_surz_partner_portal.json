                            "id": "st_pending",
                            "type": "callout",
                            "variant": "warning",
                            "icon": "clock",
                            "iconPosition": "left",
                            "title": "Your partnership request is in review",
                            "body": "Thank you for applying. Our team is reviewing your request and will email you as soon as it has been decided. You can still edit your application on the partner page until then.",
                            "visibility": {
                              "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == 'PENDING'"
                            }
                          },
                          {
                            "id": "st_pending_btns",
                            "type": "button_group",
                            "align": "left",
                            "visibility": {
                              "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == 'PENDING'"
                            },
                            "buttons": [
