          600,
          700
        ],
        "baseSize": 16,
        "scaleRatio": 1.25,
        "lineHeight": 1.6,
        "headingWeight": 600,
        "headingLineHeight": 1.2,
        "eyebrowTransform": "uppercase"
      },
      "layout": {
        "contentWidth": "wide",
        "maxWidth": 1220,
        "paddingX": 24,
        "paddingY": 0,
        "blockGap": 16,
        "borderRadius": 24,
        "buttonRadius": 999,
        "background": {
          "kind": "color",
          "color": "#F5F8FE"
        }
      }
    },
    "inputs": [
      {
        "name": "order_filter",
        "label": "Show",
        "type": "select",
        "isInput": true,
        "default": "all",
        "options": [
          {
            "label": "All orders",
            "value": "all"
          },
          {
            "label": "Paid",
            "value": "PAID"
          },
          {
            "label": "Awaiting payment",
            "value": "PENDING"
          },
          {
            "label": "Delivered",
            "value": "DELIVERED"
          }
        ]
      }
    ],
    "actions": [],
