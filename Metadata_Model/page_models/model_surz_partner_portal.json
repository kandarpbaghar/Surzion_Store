{
  "page": {
    "obj_name": "surz_partner_portal",
    "title": "My partner account",
    "kind": "external",
    "pageMode": "web",
    "pageSchemaVersion": 2,
    "theme": {
      "ref": "surzion",
      "preset": "corporate",
      "palette": {
        "primary": "#0E2358",
        "primaryHover": "#14307A",
        "onPrimary": "#FFFFFF",
        "accent": "#2F6BE6",
        "accentHover": "#14307A",
        "onAccent": "#FFFFFF",
        "heading": "#0B1A3D",
        "text": "#0B1A3D",
        "muted": "#5B6B8C",
        "subtle": "#8494B4",
        "link": "#2F6BE6",
        "linkHover": "#14307A",
        "inverted": "#FFFFFF",
        "background": "#F5F8FE",
        "surface": "#FFFFFF",
        "surfaceAlt": "#FFFFFF",
        "surfaceMuted": "#EDF1FA",
        "border": "#E4EAF6",
        "borderStrong": "#DCE4F3",
        "info": "#2F6BE6",
        "infoBg": "#E8EFFD",
        "success": "#1F9D63",
        "successBg": "#E5F5EE",
        "error": "#C2402F"
      },
      "typography": {
        "fontFamily": "poppins",
        "headingFamily": "poppins",
        "customFontFamily": "Poppins",
        "customHeadingFamily": "Poppins",
        "customFontWeights": [
          400,
