                              }
                            ]
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "oh",
                    "anchorId": "orders",
                    "type": "heading",
                    "level": 2,
                    "text": "Orders claimed with my code",
                    "visibility": {
                      "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == 'APPROVED'"
                    }
                  },
                  {
                    "id": "op",
                    "type": "paragraph",
                    "text": "Buyer names are masked. The discount is applied per item, before GST.",
                    "visibility": {
                      "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == 'APPROVED'"
                    }
                  },
                  {
                    "id": "ig_referral",
                    "type": "custom_code",
                    "html": "<div class=\"card\" id=\"card\">\n<div class=\"head\"><div><div class=\"eyebrow\">YOUR REFERRAL PERFORMANCE</div><div class=\"sub\">Last 6 months</div></div>\n<div class=\"kpi\"><div class=\"kl\">Total your followers saved</div><div class=\"kn\" id=\"total\">&#8377;0</div></div></div>\n<div id=\"body\"><div class=\"wrap\"><canvas id=\"c\"></canvas></div>\n<div class=\"legend\"><span><i style=\"background:var(--pg-primary)\"></i>Orders claimed</span><span><i style=\"background:var(--pg-accent)\"></i>Discount given</span></div></div>\n<div id=\"empty\" class=\"empty\" hidden><div class=\"et\">No claimed orders yet</div><div class=\"es\">When your followers order with your code, their orders and savings will show up here.</div></div>\n</div>",
                    "css": "*{box-sizing:border-box}body{margin:0;font-family:'Poppins',var(--pg-font),sans-serif;color:var(--pg-heading)}\n.card{background:var(--pg-surface);border:1px solid var(--pg-border);border-radius:18px;padding:24px 28px;box-shadow:0 6px 24px rgba(14,35,88,.06);opacity:0;transform:translateY(12px);transition:opacity .6s ease,transform .6s ease}\n.card.in{opacity:1;transform:none}\n.head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:12px}\n.eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;color:var(--pg-accent)}.sub{font-size:13px;color:var(--pg-muted);margin-top:2px}\n.kpi{text-align:right}.kl{font-size:13px;color:var(--pg-muted);font-weight:500}.kn{font-size:40px;font-weight:700;color:var(--pg-primary);line-height:1.1;letter-spacing:-.02em}\n.wrap{position:relative;height:260px}.legend{display:flex;gap:18px;justify-content:center;font-size:13px;color:var(--pg-muted);margin-top:10px}\n.legend i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:6px}\n.empty{text-align:center;padding:28px 12px}.eic{font-size:36px}.et{font-weight:600;font-size:18px;color:var(--pg-primary);margin-top:6px}.es{color:var(--pg-muted);font-size:14px;margin-top:4px}\n[hidden]{display:none!important}",
                    "js": "(async () => {\n  const money = n => '\\u20B9' + Number(n||0).toLocaleString('en-IN',{maximumFractionDigits:0});\n  const card = document.getElementById('card');\n  try {\n    await twasta.ready;\n    let rows = [];\n    try { rows = (await twasta.data.get('ds_claimed_orders')) || []; } catch (e) { console.error('orders load failed', e); }\n    if (!Array.isArray(rows)) rows = rows.rows || [];\n    const get = (r, k) => r[k] ?? r[k.toLowerCase()];\n    const now = new Date(), months = [];\n    for (let i = 5; i >= 0; i--) { const d = new Date(now.getFullYear(), now.getMonth() - i, 1); months.push({ key: d.getFullYear()+'-'+d.getMonth(), label: d.toLocaleString('en-IN',{month:'short'})+' '+String(d.getFullYear()).slice(2), orders:0, saved:0 }); }\n    const idx = Object.fromEntries(months.map((m,i)=>[m.key,i]));\n    rows.forEach(r => {\n      const dt = new Date(get(r,'ORDER_DATE')); if (isNaN(dt)) return;\n      const i = idx[dt.getFullYear()+'-'+dt.getMonth()]; if (i === undefined) return;\n      months[i].orders += 1; months[i].saved += Number(get(r,'DISCOUNT_AMT')) || 0;\n    });\n    const total = months.reduce((s,m)=>s+m.saved,0), count = months.reduce((s,m)=>s+m.orders,0);\n    requestAnimationFrame(() => card.classList.add('in'));\n    if (!count) { document.getElementById('body').hidden = true; document.getElementById('empty').hidden = false; return; }\n    const el = document.getElementById('total'), t0 = performance.now(), dur = 1400;\n    const tick = t => { const p = Math.min(1,(t-t0)/dur), e = 1-Math.pow(1-p,3); el.textContent = money(total*e); if (p<1) requestAnimationFrame(tick); else el.textContent = money(total); };\n    requestAnimationFrame(tick);\n    const cv = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();\n    const cPri = cv('--pg-primary'), cAcc = cv('--pg-accent'), cMut = cv('--pg-muted'), cSoft = cv('--pg-surface-muted');\n    new Chart(document.getElementById('c'), {\n      type: 'bar',\n      data: { labels: months.map(m=>m.label), datasets: [\n        { label: 'Orders claimed', data: months.map(m=>m.orders), backgroundColor: cPri, borderRadius: 6, yAxisID: 'y' },\n        { label: 'Discount given', data: months.map(m=>m.saved), backgroundColor: cAcc, borderRadius: 6, yAxisID: 'y1' } ] },\n      options: { responsive: true, maintainAspectRatio: false, interaction: { mode: 'index', intersect: false },\n        font: { family: 'Poppins' },\n        plugins: { legend: { display: false }, tooltip: { backgroundColor: cPri, titleFont: { family: 'Poppins' }, bodyFont: { family: 'Poppins' }, padding: 10,\n          callbacks: { label: c => c.datasetIndex === 0 ? ' Orders: ' + c.parsed.y : ' Saved: ' + money(c.parsed.y) } } },\n        scales: { x: { grid: { display: false }, ticks: { color: cMut } },\n          y: { beginAtZero: true, ticks: { precision: 0, color: cMut }, grid: { color: cSoft }, title: { display: true, text: 'Orders', color: cMut } },\n          y1: { beginAtZero: true, position: 'right', grid: { display: false }, ticks: { color: cMut, callback: v => money(v) }, title: { display: true, text: 'Saved', color: cMut } } } }\n    });\n  } catch (err) {\n    console.error('referral infographic failed', err);\n    card.classList.add('in');\n    document.getElementById('body').hidden = true;\n    const e = document.getElementById('empty'); e.hidden = false; e.querySelector('.et').textContent = 'Could not load your performance'; e.querySelector('.es').textContent = 'Please refresh the page to try again.';\n  }\n})();",
                    "libs": [
                      "https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"
                    ],
