                            "type": "callout",
                            "variant": "success",
                            "icon": "check-circle",
                            "iconPosition": "left",
                            "title": "Congratulations — you are a Surzion partner!",
                            "body": "Your partnership is active. Share your code or QR code: your followers get {{ds_partner.DISCOUNT_PCT}}% off every item, and every order they place with it shows below.",
