                            "variant": "info",
                            "icon": "sparkles",
                            "iconPosition": "left",
                            "title": "You have not applied yet",
                            "body": "Apply to the Surzion partner programme and, once approved, you get your own discount code and QR code for your followers.",
                            "visibility": {
