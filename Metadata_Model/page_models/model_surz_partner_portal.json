                            }
                          },
                          {
                            "id": "st_none_btns",
                            "type": "button_group",
                            "align": "left",
                            "visibility": {
                              "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == ''"
                            },
                            "buttons": [
