                      },
                      {
                        "id": "acc_r",
                        "blocks": [
                          {
                            "id": "code_card",
                            "type": "container",
                            "padding": 28,
                            "rounded": true,
                            "visibility": {
                              "condition": "{{me.signedIn}} && {{ds_partner._loaded}} && {{ds_partner.STATUS}} == 'APPROVED'"
                            },
                            "background": {
                              "kind": "color",
                              "color": "var(--pg-primary)"
                            },
                            "children": [
                              {
                                "id": "cc_e",
                                "type": "paragraph",
                                "text": "YOUR PARTNER CODE",
                                "style": {
                                  "textColor": "var(--pg-on-primary)",
                                  "typography": {
                                    "fontSize": 12,
                                    "fontWeight": 600,
                                    "letterSpacing": 0.12
                                  }
                                }
                              },
                              {
                                "id": "cc_qr",
                                "type": "image",
                                "url": "",
                                "alt": "Your partner QR code",
                                "align": "left",
                                "maxWidth": 140,
                                "bindings": {
                                  "url": {
                                    "source": "data_field",
                                    "dataSource": "ds_partner",
                                    "path": "QR_URL"
                                  }
                                }
                              },
                              {
                                "id": "cc_code",
                                "type": "heading",
                                "level": 2,
                                "text": "",
                                "style": {
                                  "textColor": "var(--pg-on-primary)"
                                },
                                "bindings": {
                                  "text": {
                                    "source": "data_field",
                                    "dataSource": "ds_partner",
                                    "path": "DISCOUNT_CODE"
                                  }
                                }
                              },
                              {
                                "id": "cc_pl",
                                "type": "paragraph",
                                "text": "Followers save this percentage on every item",
                                "style": {
                                  "textColor": "var(--pg-on-primary)"
                                }
                              },
                              {
                                "id": "cc_pct",
                                "type": "heading",
                                "level": 3,
                                "text": "{{ds_partner.DISCOUNT_PCT}}% off",
                                "style": {
                                  "textColor": "var(--pg-on-primary)"
                                }
                              },
                              {
                                "id": "cc_btns",
                                "type": "button_group",
                                "align": "left",
                                "gap": 10,
                                "buttons": [
                                  {
                                    "id": "cc_copy",
                                    "label": "Copy code",
                                    "variant": "secondary",
                                    "size": "md",
                                    "icon": "check",
                                    "on_click": {
                                      "kind": "copy",
                                      "text": "{{ds_partner.DISCOUNT_CODE}}",
                                      "confirm": "Code copied"
                                    }
                                  },
                                  {
                                    "id": "cc_dl",
                                    "label": "Download QR",
                                    "variant": "outline",
                                    "size": "md",
                                    "icon": "download",
                                    "on_click": {
                                      "kind": "external_url",
                                      "url": "{{ds_partner.QR_URL}}",
                                      "newTab": true
                                    }
                                  },
                                  {
                                    "id": "cc_share",
                                    "label": "Share link",
                                    "variant": "outline",
                                    "size": "md",
                                    "on_click": {
                                      "kind": "copy",
                                      "text": "Shop Surzion surgical instruments and use my code {{ds_partner.DISCOUNT_CODE}} at checkout.",
                                      "confirm": "Share message copied"
                                    }
                                  }
