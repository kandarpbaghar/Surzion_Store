            "csv_column": "SLUG",
            "transaction_form": "1",
            "form_field": "slug"
          },
          {
            "csv_column": "SORT_ORDER",
            "transaction_form": "1",
            "form_field": "sort_order"
          },
          {
            "csv_column": "IS_ACTIVE",
            "transaction_form": "1",
            "form_field": "is_active"
          }
        ]
      }
    ]
  }
}
