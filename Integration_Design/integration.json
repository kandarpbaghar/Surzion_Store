        },
        {
          "name": "partner_name",
          "type": "string",
          "description": "Partner contact name",
          "required": true
        },
        {
          "name": "org_name",
          "type": "string",
          "description": "Partner organisation name",
          "required": false
        },
        {
          "name": "email",
          "type": "string",
          "description": "Applicant e-mail address (recipient of the acknowledgement)",
          "required": true
        },
        {
          "name": "phone",
          "type": "string",
          "description": "Applicant phone",
          "required": false
        },
        {
          "name": "handle",
          "type": "string",
          "description": "Social handle",
          "required": false
        },
        {
          "name": "platform",
          "type": "string",
          "description": "Main platform",
          "required": false
        },
        {
          "name": "profile_url",
          "type": "string",
          "description": "Profile URL",
          "required": false
        },
        {
          "name": "follower_range",
          "type": "string",
          "description": "Follower range",
          "required": false
        },
        {
          "name": "audience",
          "type": "string",
          "description": "Audience description",
          "required": false
        }
      ],
      "active": true
