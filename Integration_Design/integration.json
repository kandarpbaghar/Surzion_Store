{
  "version": 2,
  "events": [
    {
      "event_name": "surz_order_confirmed",
      "display_name": "Surzion order confirmed",
      "description": "Emitted once by the surz_order post_commit BL when an order is first placed. The flow should email the customer (email) the order confirmation, using subject and body, or render its own template from the order, lines and amounts. Money values are exact 2-decimal strings.",
      "source": {
        "type": "custom"
      },
      "params": [],
      "arguments": [
        {
          "name": "order_no",
          "type": "string",
          "description": "Order number",
          "required": true
        },
        {
          "name": "order_date",
          "type": "string",
          "description": "Order date, YYYY-MM-DD or YYYY-MM-DD HH:MM",
          "required": false
        },
        {
          "name": "email",
          "type": "string",
          "description": "Customer e-mail address (recipient)",
          "required": true
        },
        {
          "name": "customer_name",
          "type": "string",
          "description": "Customer name",
          "required": false
        },
        {
          "name": "phone",
          "type": "string",
          "description": "Customer phone",
          "required": false
        },
        {
          "name": "ship_address",
          "type": "string",
          "description": "Shipping address",
          "required": false
        },
        {
          "name": "subtotal",
          "type": "string",
          "description": "Subtotal, 2dp string",
          "required": false
        },
        {
          "name": "discount_amt",
          "type": "string",
          "description": "Discount amount, 2dp string",
          "required": false
        },
        {
          "name": "gst_amt",
          "type": "string",
          "description": "GST amount, 2dp string",
          "required": false
        },
        {
          "name": "shipping_amt",
          "type": "string",
          "description": "Shipping amount, 2dp string",
          "required": false
        },
        {
          "name": "total_amount",
          "type": "string",
          "description": "Order total, 2dp string",
          "required": true
        },
        {
          "name": "paid_amount",
          "type": "string",
          "description": "Amount paid so far, 2dp string",
          "required": false
        },
        {
          "name": "amount_due",
          "type": "string",
          "description": "Outstanding amount, 2dp string",
          "required": false
        },
        {
          "name": "payment_due",
          "type": "boolean",
          "description": "True when an amount is still outstanding",
          "required": false
        },
        {
          "name": "pay_status",
          "type": "string",
          "description": "Payment status (upper case)",
          "required": false
        },
        {
          "name": "pay_method",
          "type": "string",
          "description": "Payment method",
          "required": false
        },
        {
          "name": "lines",
          "type": "object",
          "description": "List of order lines, each with line_no, product_code, product_name, qty, unit_price, line_total (all strings)",
          "required": false
        },
        {
          "name": "subject",
          "type": "string",
          "description": "Ready-made e-mail subject",
          "required": false
        },
        {
          "name": "body",
          "type": "string",
          "description": "Ready-made plain-text e-mail body",
          "required": false
        }
      ],
      "active": true
    },
    {
      "event_name": "surz_partner_registered",
      "display_name": "Surzion partner registered",
      "description": "Emitted when a partner application is submitted. The flow should email an acknowledgement to the applicant (email) and send a notice of the new application to the admin.",
