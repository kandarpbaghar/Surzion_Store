    {
      "event_name": "surz_partner_approved",
      "display_name": "Surzion partner approved",
      "description": "Emitted when a partner is approved. The flow should email a welcome message to the partner (email) with the QR image (qr_url) and the discount code and percentage in the text, plus the portal link. Optionally copy admin_email.",
      "source": {
        "type": "custom"
      },
      "params": [],
      "arguments": [
        {
          "name": "partner_id",
          "type": "string",
          "description": "Partner ID",
          "required": true
        },
        {
          "name": "partner_name",
          "type": "string",
          "description": "Partner name",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "description": "Partner e-mail address (recipient)",
          "required": true
        },
        {
          "name": "discount_code",
          "type": "string",
          "description": "Partner discount code",
          "required": true
        },
        {
          "name": "discount_pct",
          "type": "string",
          "description": "Discount percentage, exact 2-decimal string",
          "required": true
        },
        {
          "name": "qr_url",
          "type": "string",
          "description": "URL of the partner QR image",
          "required": true
        },
        {
          "name": "portal_url",
          "type": "string",
          "description": "Link to the partner portal",
          "required": true
        },
        {
          "name": "admin_email",
          "type": "string",
          "description": "Admin e-mail address to copy, if any",
          "required": false
        }
      ],
      "active": true
    },
    {
      "event_name": "surz_partner_rejected",
      "display_name": "Surzion partner rejected",
      "description": "Emitted when a partner application is rejected. The flow should email the applicant (email) a polite rejection stating the reason.",
      "source": {
        "type": "custom"
      },
      "params": [],
      "arguments": [
        {
          "name": "partner_id",
          "type": "string",
          "description": "Partner ID",
          "required": true
        },
        {
          "name": "partner_name",
          "type": "string",
          "description": "Partner name",
          "required": true
        },
        {
          "name": "email",
          "type": "string",
          "description": "Applicant e-mail address (recipient)",
          "required": true
        },
        {
          "name": "reason",
          "type": "string",
          "description": "Rejection reason",
          "required": false
        }
      ],
      "active": true
    },
    {
      "event_name": "notification.created",
      "display_name": "Notification raised",
      "description": "Somebody was told something in the app \u2014 work assigned, an approval decided, a job finished. Twasta always writes the in-app row itself; a flow on this event is how it also reaches email, WhatsApp, Slack or Telegram, so there is ONE delivery implementation rather than one per producer.",
      "source": {
        "type": "custom"
      },
      "arguments": [
        {
          "name": "kind",
          "type": "string",
          "required": true,
          "description": "task_assigned | task_opened | task_closed | approval | job | alert | info"
        },
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "The one line the recipient reads."
        },
        {
          "name": "body",
          "type": "string",
          "description": "Optional detail under the title."
        },
        {
          "name": "users",
          "type": "array",
          "required": true,
          "description": "The user ids told, roles already expanded to members."
        },
        {
          "name": "source_ref",
          "type": "string",
          "description": "What it is about (a task key, an approval instance)."
        },
        {
          "name": "actor",
          "type": "string",
          "description": "Who caused it (excluded from the recipients)."
        }
      ],
      "active": true,
      "managed": true
    }
  ],
